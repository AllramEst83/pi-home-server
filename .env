# Every app gets <name>.${DOMAIN}, e.g. glances.192-168-0-43.sslip.io
#
# sslip.io: public DNS that answers <anything>.192-168-0-43.sslip.io with
# 192.168.0.43. Nothing to set up, and the address only works inside the home.
# Later, with your own DNS (AdGuard Home rewrite *.pi.home.arpa -> 192.168.0.43),
# change this to pi.home.arpa and run: docker compose up -d
DOMAIN=192-168-0-43.sslip.io

# Only these addresses may open the apps (your home network).
LAN_RANGE=192.168.0.0/24
